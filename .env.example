# --- Mode ---
USE_MOCK=true                  # true = MockLLMClient + MockEmailIngestor, no external calls, no keys needed
ENVIRONMENT=development
LOG_LEVEL=INFO

# Point this at a generated sample dataset (scripts/generate_sample_data.py)
# to test "Scan email" at volume with zero OAuth setup. Only used when
# USE_MOCK=true. Leave blank to disable.
MOCK_EMAIL_FIXTURES_PATH=

# --- Auth ---
# Leave blank — a key is auto-generated and persisted to DATA_DIR/.secret_key
# on first run. Set explicitly for a stable key across environments.
SECRET_KEY=

# --- LLM (OpenRouter primary, OpenAI fallback) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_TRIAGE_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct   # cheap/fast bulk filter
LLM_SCORING_MODEL=openrouter/openai/gpt-4.1-mini                # deep scoring on shortlist
LLM_JUDGE_MODEL=openrouter/anthropic/claude-3.5-sonnet          # judge / borderline re-score
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small

# --- Email OAuth (Phase 1: Gmail + Microsoft Graph) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=common
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# --- Storage ---
DATA_DIR=./data                # SQLite db + candidate/resume mirror live here
SQLITE_PATH=./data/recruit_assistant.db

# --- Scheduler (opt-in nightly auto-scan) ---
# Off by default. Even when true, only sources explicitly marked "auto-scan
# nightly" on the Scan Sources page are touched — see architecture/project-log.md.
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=2                # 0-23, local time

# --- Server ---
API_PORT=8000
